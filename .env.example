# ==============================================================================
# Folio — Environment Variables
# Copy this file to .env.local and fill in your values.
# Leave NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY empty to run
# in 100% offline Local Mode (IndexedDB + local file database).
# ==============================================================================

# Public (safe in browser because Row-Level Security is enforced on every table)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — only if you want to sponsor a shared AI key for approved friends
# NEVER prefix these with NEXT_PUBLIC_
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_DAILY_LIMIT_PER_USER=30

# SECURITY NOTE:
# Do NOT add SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY anywhere in the application!
# The secret/service_role key bypasses all Row-Level Security policies.
